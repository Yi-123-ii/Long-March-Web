        }
      ]
    },
    {
      "id": "XN009",
      "file": "XN009.mp3",
      "text": "船里的人往里挪开，终于空出位置。梁叔托着行装走上木板，我跟在他后头。",
      "duration": 8.395,
      "sentence_ids": [
        "XN009-01",
        "XN009-02"
      ],
      "cues": [
        {
