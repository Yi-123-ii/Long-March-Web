          "end": 2.3774999999999977
        }
      ]
    },
    {
      "id": "XN008",
      "file": "XN008.mp3",
      "text": "还没轮到我们上船，梁叔把肩上的行装往上托了托，和我站到旁边。船帮撞了一下木桩，远处的狗叫声隔着水传过来。",
      "duration": 12.51,
      "sentence_ids": [
        "XN008-01",
        "XN008-02"
      ],
      "cues": [
        {
          "text": "还没轮到我们上船，梁叔把肩上的行装往上托了托，和我站到旁边。",
          "start": 0.2874999999999943,
          "end": 6.207499999999996
        },
        {
          "text": "船帮撞了一下木桩，远处的狗叫声隔着水传过来。",
