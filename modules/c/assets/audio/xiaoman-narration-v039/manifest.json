      ]
    },
    {
      "id": "XN006",
      "file": "XN006.mp3",
      "text": "我刚把铺盖往背上托稳，带子的一头又拖进泥里。梁叔伸手指了指，我这才低头看见。",
      "duration": 9.0725,
      "sentence_ids": [
        "XN006-01",
